rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /pledges/{pledgeId} {
      // Any authenticated user (including anonymous admin) can read
      allow read: if request.auth != null;
      // Students can create their own pledges
      allow create: if request.auth != null;
      // Only disallow delete/update for anonymous (admin uses localStorage check)
      allow delete, update: if request.auth != null;
    }
  }
}
